{
  "name": "quiz-studio-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Quiz Studio for Windows",
  "author": "Quiz Studio",
  "main": "main.js",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.iqra.quizstudio",
    "productName": "Quiz Studio",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "package.json"],
    "win": { "target": ["nsis"], "icon": "build/icon.png", "artifactName": "Quiz-Studio-Setup.${ext}" },
    "nsis": { "oneClick": true, "perMachine": false, "createDesktopShortcut": true, "shortcutName": "Quiz Studio" }
  }
}
